# LLM (existing integration, used by Admin AI and the Voice Assistant)
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.5-flash-lite

# Voice Assistant — Speech-to-Text (independent from the LLM)
# faster_whisper: local, free, model downloads on first use
# openai_whisper: OpenAI Whisper API, requires STT_API_KEY
STT_PROVIDER=faster_whisper
STT_API_KEY=
# STT_MODEL=small            # faster_whisper: tiny|base|small|medium; openai_whisper: whisper-1
# STT_DEVICE=cpu
# STT_COMPUTE_TYPE=int8
VOICE_MAX_AUDIO_MB=10

# Text-to-Speech runs in the browser (SpeechSynthesis API)
TTS_PROVIDER=browser
